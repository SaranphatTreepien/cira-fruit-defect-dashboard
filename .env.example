# Copy to .env (Docker + Telegram/Gemini) and .env.local (web + Python scripts).
# Never commit the real files: both are in .gitignore.

# --- .env : read by docker compose and the Python scripts ---------------------------
DB_USER=cira
DB_PASSWORD=change-me
DB_NAME=cira_core

TELEGRAM_BOT_TOKEN=          # from @BotFather (alerts, daily report, menu bot)
TELEGRAM_CHAT_ID=            # chat / group that receives alerts
GEMINI_API_KEY=              # AI summary (web + Telegram bot)
# GEMINI_MODEL=gemini-flash-lite-latest

# --- .env.local : read by Next.js and the Python scripts ----------------------------
DATABASE_URL=postgresql://cira:change-me@127.0.0.1:15432/cira_core

# mqtt_to_db.py
BATCH_SIZE=50
FLUSH_SEC=1.0
LOG_LEVEL=INFO
# DEDUP_TRACK_SEC=30        # same run + track_id within N s = same fruit (0 = off)
# MQTT_HOST=127.0.0.1
# MQTT_PORT=1883
# MQTT_TOPIC=cira/fruit/events
# MQTT_STATUS_TOPIC=cira/fruit/status/

# Login page demo account (admin@demo.local). Set DEMO_LOGIN=0 outside demos.
# DEMO_LOGIN=1
# DEMO_ADMIN_PASSWORD=demo-admin-1234

# alert_watcher.py
# HEALTHCHECK_URL=https://www.google.com/generate_204
